<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EduNexa | Reset Password</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #f5f9ff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background-image: linear-gradient(to bottom right, #f0f7ff, #e6f0ff);
      position: relative;
      overflow-x: hidden;
    }

    /* Background decorative elements */
    .bg-circle {
      position: absolute;
      border-radius: 50%;
      /* background: rgba(74, 107, 255, 0.05); */ background-color: #0f172a; /* Midnight blue */
      z-index: -1;
    }

    .circle-1 {
      width: 300px;
      height: 300px;
      top: -150px;
      left: -150px;
    }

    .circle-2 {
      width: 200px;
      height: 200px;
      bottom: -100px;
      right: -100px;
      /* background: rgba(102, 126, 234, 0.08); */
      background: #0f172a; /* Midnight blue */

    }

    .container {
      width: 100%;
      max-width: 480px;
      background-color: white;
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(74, 107, 255, 0.1);
      overflow: hidden;
      transition: transform 0.3s ease;
    }

    .container:hover {
      transform: translateY(-5px);
    }

    .header {
      /* background: linear-gradient(135deg, #4a6bff 0%, #3a56e0 100%); */
      background-color: #0f172a; /* Midnight blue */
      color: white;
      padding: 30px;
      text-align: center;
      position: relative;
    }

    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 15px;
      font-size: 24px;
      font-weight: 700;
    }

    .logo i {
      margin-right: 10px;
      font-size: 28px;
    }

    .header h1 {
      font-size: 26px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .header p {
      opacity: 0.9;
      font-size: 15px;
      max-width: 400px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .form-container {
      padding: 40px;
    }

    .form-intro {
      margin-bottom: 25px;
      color: #555;
      line-height: 1.6;
      font-size: 15px;
      text-align: center;
    }

    .form-intro i {
      /* color: #4a6bff; */
      color:#0f172a;
      margin-right: 8px;
    }

    .form-group {
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 600;
      color: #333;
      font-size: 16px;
    }

    .input-with-icon {
      position: relative;
    }

    .input-with-icon i {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #7a7f9a;
      font-size: 18px;
    }

    input[type="password"] {
      width: 100%;
      padding: 16px 20px 16px 50px;
      border: 2px solid #e1e7ff;
      border-radius: 12px;
      font-size: 16px;
      transition: all 0.3s;
      background-color: #f9fbff;
    }

    input[type="password"]:focus {
      outline: none;
      /* border-color: #4a6bff; */
      border-color: #0f172a;
      background-color: white;
      box-shadow: 0 0 0 4px rgba(74, 107, 255, 0.15);
    }

    input[type="password"]::placeholder {
      color: #a0a7c2;
    }

    button {
      width: 100%;
      padding: 17px;
      /* background: linear-gradient(135deg, #4a6bff 0%, #3a56e0 100%); */
      background-color: #0f172a; /* Midnight blue */
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 5px 15px rgba(74, 107, 255, 0.3);
    }

    button:hover {
      /* background: linear-gradient(135deg, #3a56e0 0%, #2a46d0 100%); */
      background:linear-gradient(#0f172a); /* Midnight blue */
      transform: translateY(-2px);
      box-shadow: 0 7px 20px rgba(74, 107, 255, 0.4);
    }

    button:active {
      transform: translateY(0);
    }

    button i {
      margin-right: 10px;
      font-size: 18px;
    }

    .back-to-login {
      text-align: center;
      margin-top: 30px;
      padding-top: 25px;
      border-top: 1px solid #eef2ff;
    }

    .back-to-login a {
      /* color: #4a6bff; */
      color: #0f172a;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      transition: color 0.3s;
      display: inline-flex;
      align-items: center;
    }

    .back-to-login a:hover {
      color: #2a46d0;
      text-decoration: underline;
    }

    .back-to-login i {
      margin-right: 8px;
      font-size: 14px;
    }

    .illustration {
      text-align: center;
      margin-bottom: 25px;
    }

    .illustration i {
      font-size: 70px;
      /* color: #4a6bff; */
      color: #0f172a;
      opacity: 0.8;
    }

    /* Responsive adjustments */
    @media (max-width: 600px) {
      .container {
        max-width: 100%;
      }
      
      .header, .form-container {
        padding: 25px;
      }
      
      .header h1 {
        font-size: 22px;
      }
      
      .illustration i {
        font-size: 60px;
      }
    }

    @media (max-width: 400px) {
      .header, .form-container {
        padding: 20px;
      }
      
      .header h1 {
        font-size: 20px;
      }
      
      input[type="password"] {
        padding: 14px 18px 14px 45px;
      }
      
      button {
        padding: 15px;
      }
    }

    /* Animation for form submission */
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.02); }
      100% { transform: scale(1); }
    }

    .pulse {
      animation: pulse 0.5s ease;
    }
  </style>
</head>
<body>
  <div class="bg-circle circle-1"></div>
  <div class="bg-circle circle-2"></div>
  
  <div class="container" id="formContainer">
    <div class="header">
      <div class="logo">
        <i class="fas fa-graduation-cap"></i>
        <span>EDUNEXA</span>
      </div>
      <h1>Reset Password</h1>
      <p>Create a new secure password for your EduNexa account.</p>
    </div>
    
    <div class="form-container">
      <div class="illustration">
        <i class="fas fa-key"></i>
      </div>
      
      <p class="form-intro">
        <i class="fas fa-info-circle"></i>
        Enter a new password below. Make sure it's strong, secure and memorable.
      </p>
      
      <form method="POST" action="/reset-password">
        <div class="form-group">
          <label for="password">Enter your password:</label>
          <div class="input-with-icon">
            <i class="fa-solid fa-lock"></i>
            <input type="hidden" name="token" value="<%= token %>" />
            <input type="password" name="newPassword" id="newPassword" required />
            <!-- <span onclick="togglePassword()" style="position: absolute; right: 20px; bottom: 25%; transform: translateY(-50%); cursor: pointer; font-size: 18px; color: #666;" id="toggleIcon">
              👁️
            </span> -->
          </div>
        </div>

        <button type="submit" id="submitBtn">
          <i class="fas fa-paper-plane"></i>
          RESET PASSWORD
        </button>
      </form>
      
  </div>

  <script>
    // Form submission animation
    const form = document.getElementById('forgotPasswordForm');
    const formContainer = document.getElementById('formContainer');
    const submitBtn = document.getElementById('submitBtn');
    
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      // Add pulse animation
      formContainer.classList.add('pulse');
      
      // Change button text and disable it
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
      submitBtn.disabled = true;
      
      // Simulate API call delay
      setTimeout(() => {
        // In a real application, you would submit the form here
        // For this example, we'll just show an alert
        alert('Password Updated!');

        // Clears the form fields
        // form.reset();
        window.location.href="/";
        
        // Reset button
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
        
        // Remove animation class
        formContainer.classList.remove('pulse');
      }, 1500);
    });

    function togglePassword() {
      const passwordInput = document.getElementById("newPassword");
      const toggleIcon = document.getElementById("toggleIcon");

      if (passwordInput.type === "password") {
        passwordInput.type = "text";
        toggleIcon.textContent = "🙈"; // eye closed emoji
      } else {
        passwordInput.type = "password";
        toggleIcon.textContent = "👁️"; // eye open emoji
      }

    }
  </script>
</body>
</html>